# Скопировать в .env и поправить под свою машину:
#     cp .env.example .env
#
# Значения ниже рассчитаны на Linux-сервер. На Windows укажите пути в
# формате D:\папка (см. комментарии).

COMPOSE_PROJECT_NAME=local-ai

# --- где лежат данные ---
# Каталоги создаются автоматически при первом запуске.
# Диск с запасом: база растёт вместе с документами (~1 ГБ на тысячу).
QDRANT_DIR=/srv/local-ai/qdrant
CODE_DIR=/srv/local-ai/code
DOCS_DIR=/srv/local-ai/docs
TEI_DIR=/srv/local-ai/tei

# --- модели ---
# Генеративная модель отвечает пользователю и переформулирует запросы.
# Эмбеддер обязан быть ТОТ ЖЕ, которым индексировали: иначе векторы окажутся
# из разных пространств, и поиск начнёт возвращать шум, не падая с ошибкой.
GEN_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# --- доступ к модели ---
# ГДЕ ЖИВЁТ МОДЕЛЬ. Ollama разворачивается отдельно, на машине с видеокартой;
# этот стек её не поднимает и не настраивает — только обращается по сети.
# Здесь GPU не нужен.
OLLAMA_URL=http://llm.company.local:11434/v1

# Токен, если Ollama закрыта прокси или шлюзом (vLLM, LiteLLM).
# ВАЖНО: Continue ходит в модель НАПРЯМУЮ за генерацией ответа, минуя наш
# сервер — тот же ключ надо прописать и в ~/.continue/config.yaml, но в поле
# requestOptions.headers, а НЕ apiKey: apiKey уходит как "Authorization:
# Bearer <токен>", и шлюз с x-api-key такой запрос отобьёт. Готовый образец —
# continue-config.example.yaml
OLLAMA_API_KEY=
# Если шлюз ждёт ключ в другом заголовке:
# OLLAMA_AUTH_HEADER=x-api-key
# OLLAMA_AUTH_PREFIX=

# --- порты ---
QDRANT_PORT=6333
KB_PORT=8010
CODE_GRAPH_PORT=8011

# --- поиск ---
# Порог отсечки нерелевантного. Подобран на нашем корпусе; на других данных
# проверить: слишком высокий срезает верные ответы, слишком низкий пропускает
# мусор. Мерить эталонными вопросами (kb/eval.py), а не на глаз.
KB_MIN_SCORE=0.48
# Расширение запроса: модель переформулирует вопрос в терминах документации.
# Дало прирост с 87% до 100% на нашем наборе. Выключается KB_EXPAND=0
KB_EXPAND=1
# Реранкер второй ступени. Требует профиля quality
KB_RERANK=0

# Какое API дёргать у Ollama: openai (по умолчанию, пути /v1/...) или native
# (родные /api/embed и /api/chat). Некоторые шлюзы пробрасывают только одно
# из двух — если в логах 404 на /v1/embeddings, ставьте native
OLLAMA_API=openai

# --- CONFLUENCE ---
# Выгрузка страниц в markdown: python confluence/sync.py
# Адрес вики. Если она в подкаталоге, укажите целиком: https://host/confluence
CONFLUENCE_URL=

# Personal Access Token: в Confluence профиль -> Personal Access Tokens.
# Это НЕ пароль. Уходит заголовком Authorization: Bearer
CONFLUENCE_TOKEN=

# Идентификаторы КОРНЕВЫХ страниц через запятую: забирается сама страница и
# всё поддерево под ней. Идентификатор виден в адресе: ...?pageId=123456
CONFLUENCE_PAGES=

# Куда складывать. ДОЛЖНО быть внутри DOCS_DIR, иначе контейнер не увидит
# выгруженные страницы при индексации
CONFLUENCE_OUT=/srv/local-ai/docs/confluence

# --- JIRA ---
# Выгрузка задач: python jira/sync.py --check, потом без ключа.
# Только Jira Server/Data Center. У Cloud другая схема входа и другой путь
# (/rest/api/3), скрипт её не умеет.
# Если Jira в подкаталоге, укажите целиком: https://host/jira
JIRA_URL=

# Personal Access Token: профиль -> Personal Access Tokens. Это НЕ пароль,
# уходит заголовком Authorization: Bearer. В сборках старше Jira 8.14
# персональных токенов нет — тогда заполните JIRA_USER и JIRA_PASSWORD
JIRA_TOKEN=
JIRA_USER=
JIRA_PASSWORD=

# Ключи проектов через запятую. ПЕРВАЯ И ГЛАВНАЯ ГРАНИЦА: чего здесь нет,
# то не выгружается и в базу не попадает. Ключ виден в номере задачи:
# DEVSEC-412 -> DEVSEC
JIRA_PROJECTS=

# Вторая граница — состав команды. Внутри общего проекта берутся только
# задачи её людей. Логины (не отображаемые имена!) через запятую:
JIRA_TEAM=
# То же самое, но составом рулит Jira, а не .env. Требует права видеть
# состав группы; если его нет, останется JIRA_TEAM
JIRA_TEAM_GROUP=
# ВНИМАНИЕ: обе переменные фильтруют ПО ИСПОЛНИТЕЛЮ, то есть задачи без
# исполнителя (бэклог) не приедут. Если нужны — оставьте обе пустыми либо
# опишите условие сами в JIRA_JQL

# Третья граница — глубина истории. Задачи, которые не трогали год, в поиске
# в основном шумят, а в индексации стоят дороже всего: именно эмбеддинги, а не
# запросы к Jira, занимают почти всё время первого прогона.
# Относительный срок в понятиях JQL (30d, 6M) или дата (2026-08-01).
# ОСТОРОЖНО: строчная m в JQL — это МИНУТЫ. Месяцы пишутся заглавной M
JIRA_SINCE=30d

# Своё условие JQL, если стандартных рамок мало. Складывается с остальными
# через AND, например: labels = security AND created >= -180d
JIRA_JQL=

# Тянуть комментарии (1) или только описания (0). Комментарии кратно
# увеличивают индекс, но именно в обсуждении обычно и лежит решение
JIRA_COMMENTS=1

# Куда складывать. ДОЛЖНО быть внутри DOCS_DIR, иначе контейнер не увидит
# выгруженные задачи при индексации
JIRA_OUT=/srv/local-ai/docs/jira

# --- репозитории для графа и поиска по коду ---
# Через запятую. Приватные — с токеном в URL:
#   https://oauth2:ТОКЕН@git.company.local/team/service.git
# Можно оставить пустым и просто положить проекты папками в CODE_DIR — граф и
# индекс строятся и так. Клонирование нужно, только если код тянется из git;
# тогда в образе понадобится git, см. INSTALL_GIT ниже.
CODE_REPOS=

# --- ЗЕРКАЛА ДЛЯ СБОРКИ ОБРАЗОВ ---
# Нужны только там, где нет прямого выхода в интернет. Значения по умолчанию —
# публичные адреса, то есть на машине с доступом этот раздел можно не трогать.
# Действуют ТОЛЬКО во время сборки образов, на работу стека не влияют.

# Индекс PyPI. Хвост /simple обязателен, без него pip получает 404:
#   PIP_INDEX_URL=https://nexus.company.local/repository/pypi-proxy/simple
PIP_INDEX_URL=
# Только для зеркала с сертификатом внутреннего УЦ: pip перестанет проверять
# TLS для этого хоста. С валидным сертификатом оставить пустым
PIP_TRUSTED_HOST=

# Ставить ли git в образ code-graph. По умолчанию нет — и тогда apt не
# задействован вовсе, а значит не нужны ни зеркала Debian, ни ключи подписи.
# Включать, только если заполнена CODE_REPOS: без git нечем клонировать.
# graphify без git работает — он это предусматривает
INSTALL_GIT=no

# --- всё, что ниже, действует только при INSTALL_GIT=yes ---
# Адреса задаются ЦЕЛИКОМ, а не одним хостом: у Nexus и подобных прокси путь
# вида /repository/<имя>. Источников ДВА, и security обязателен: перенаправив
# только основной, apt всё равно полезет наружу за -security и упадёт
#   APT_URI=https://nexus.company.local/repository/debian
#   APT_SECURITY_URI=https://nexus.company.local/repository/debian-security
APT_URI=
APT_SECURITY_URI=
# Зеркала часто проксируют только сам trixie. Если trixie-updates у зеркала
# нет, apt падает на "does not have a Release file" — оставьте здесь trixie
APT_SUITES=trixie trixie-updates
# ОСЛАБЛЕНИЕ. yes — не проверять подпись репозитория. Нужно, когда зеркало
# подписано своим ключом, которого нет среди официальных ключей Debian.
# Ценой того, что apt перестаёт замечать подмену пакетов
APT_TRUSTED=no
