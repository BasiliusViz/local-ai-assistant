# HTTPS перед Open WebUI (сервис webui-tls в docker-compose.yml).
# Сертификат и ключ — файлами из WEBUI_CERT_DIR: server.crt, server.key.
# Как сделать самоподписанный — guides/OPEN-WEBUI.md.
# Шаблон: при старте образ nginx подставляет ${WEBUI_HTTPS_PORT} (только
# заданные переменные окружения; $host и прочие переменные nginx не трогает).

# Адрес open-webui ищем через DNS Docker при каждом запросе, а не на старте:
# иначе nginx не запустится, пока open-webui ещё поднимается
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:1m;

    # HSTS не включаем: с самоподписанным сертификатом браузер потом не даст
    # открыть страницу даже через «всё равно перейти»
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Загрузка файлов в Open WebUI выключена, но аватар и импорт чатов — мелочь
    client_max_body_size 20m;

    location / {
        set $upstream http://open-webui:8080;
        proxy_pass $upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Веб-сокеты: через них Open WebUI отдаёт ответ модели по мере генерации
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Поток не копить: иначе ответ появится только целиком
        proxy_buffering off;
        proxy_cache off;

        # Модель с инструментами может думать минутами
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Кто зашёл по HTTP на порт 80 — отправить на HTTPS, а не показать ошибку
server {
    listen 80;
    server_name _;
    return 301 https://$host:${WEBUI_HTTPS_PORT}$request_uri;
}
