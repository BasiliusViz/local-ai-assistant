# Скопировать в .env рядом с этим файлом и заполнить.
# .env не коммитится и не выносится из контура.

# Адрес Confluence. ВАЖНО: если он живёт в подкаталоге, укажите его целиком,
# например https://wiki.company.local/confluence
CONFLUENCE_URL=https://wiki.company.local

# Personal Access Token: в Confluence профиль -> Personal Access Tokens.
# Не пароль и не логин
CONFLUENCE_TOKEN=

# Ключи спейсов через запятую. Пусто = все доступные пользователю.
# Начните с одного-двух, чтобы проверить конвертацию
CONFLUENCE_SPACES=DEV,OPS

# Куда складывать markdown
CONFLUENCE_OUT=./confluence/pages
