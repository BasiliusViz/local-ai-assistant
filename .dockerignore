# В образ не должно попадать локальное состояние и данные: файл синхронизации
# Confluence, попав внутрь, заставляет выгрузку думать, что всё уже выгружено,
# и она молча не пишет ни строчки.
.venv/
__pycache__/
*.pyc
.env
confluence/.env
confluence/.sync_state.json
confluence/pages/
corpus/
data/
.git/
*.log
win_old/
guides/
# Данные на сервере лежат ВНУТРИ каталога проекта (/srv/local-ai/qdrant, cb...,
# см. .env.example). Без этих строк docker при каждой сборке kb и dojo
# пересылал их все в сборщик — гигабайты кода релиза и базы Qdrant,
# сборка шла минутами. В образ kb они не нужны: код ему монтируется
qdrant/
docs/
tei/
cb/
cb-excluded/
# code/ — образ code-graph со своим контекстом (./code), kb он не нужен;
# там же могут лежать клоны обычного кода, если CODE_DIR=<проект>/code
code/
