# Настройки для Windows-сервера. Скопировать в .env и заполнить три строки,
# помеченные ЗАПОЛНИТЬ. Остальное менять не обязательно.
#
#     copy .env.windows.example .env
#
# Модель (Ollama) на этой машине НЕ разворачивается — она на отдельном сервере
# с видеокартой. Здесь работают только Qdrant, поиск и граф кода, им хватает
# процессора.

COMPOSE_PROJECT_NAME=local-ai

# --- ГДЕ ЖИВЁТ МОДЕЛЬ (заполнить обязательно) ---
# Адрес сервера с Ollama. Проверить доступность заранее:
#     curl http://АДРЕС:11434/api/tags
# Значения держим латиницей: кириллица внутри .env на Windows едет кодировкой
OLLAMA_URL=http://CHANGE-ME:11434/v1

# Токен, если Ollama закрыта прокси или шлюзом. Если открыта — оставить пустым.
# ВАЖНО: Continue ходит в модель напрямую, тот же токен нужен и в его конфиге
OLLAMA_API_KEY=

# Если шлюз ждёт ключ не в Authorization: Bearer, а иначе:
# OLLAMA_AUTH_HEADER=x-api-key
# OLLAMA_AUTH_PREFIX=

# Имена моделей на том сервере. Эмбеддер обязан быть ТОТ ЖЕ, которым
# индексировали: иначе поиск начнёт возвращать шум, не падая с ошибкой
GEN_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# --- ГДЕ ХРАНИТЬ ДАННЫЕ ---
# Диск с запасом: база растёт вместе с документами (~1 ГБ на тысячу).
# Каталоги создадутся сами при первом запуске
QDRANT_DIR=D:\local-ai\qdrant
DOCS_DIR=D:\local-ai\docs
CODE_DIR=D:\local-ai\code

# --- КОД ---
# Пусто — код не клонируется: положите его в CODE_DIR\repos\<название>.
# Либо укажите репозитории через запятую, с токеном в URL:
#   https://oauth2:ТОКЕН@git.company.local/team/service.git
CODE_REPOS=

# --- ПОРТЫ ---
# Открыты всем, кто дотянется по сети: аутентификации нет.
# Ограничьте брандмауэром своей подсетью
QDRANT_PORT=6333
KB_PORT=8010
CODE_GRAPH_PORT=8011

# --- ПОИСК ---
# Порог отсечки нерелевантного. Подобран на нашем корпусе, на других данных
# проверить эталонными вопросами (kb/eval.py), а не на глаз
KB_MIN_SCORE=0.48
# Расширение запроса: модель переформулирует вопрос в терминах документации.
# Дало прирост с 87% до 100% на нашем наборе
KB_EXPAND=1
KB_RERANK=0
