# Настройки для Windows-сервера. Скопировать в .env и заполнить три строки,
# помеченные ЗАПОЛНИТЬ. Остальное менять не обязательно.
#
#     copy .env.windows.example .env
#
# Модель (Ollama) на этой машине НЕ разворачивается — она на отдельном сервере
# с видеокартой. Здесь работают только Qdrant, поиск и граф кода, им хватает
# процессора.

COMPOSE_PROJECT_NAME=local-ai

# --- ГДЕ ЖИВЁТ МОДЕЛЬ (заполнить обязательно) ---
# Адрес сервера с Ollama. Проверить доступность заранее:
#     curl http://АДРЕС:11434/api/tags
# Значения держим латиницей: кириллица внутри .env на Windows едет кодировкой
OLLAMA_URL=http://CHANGE-ME:11434/v1

# Токен, если Ollama закрыта прокси или шлюзом. Если открыта — оставить пустым.
# ВАЖНО: Continue ходит в модель напрямую, тот же токен нужен и в его конфиге
OLLAMA_API_KEY=

# Если шлюз ждёт ключ не в Authorization: Bearer, а иначе:
# OLLAMA_AUTH_HEADER=x-api-key
# OLLAMA_AUTH_PREFIX=

# Имена моделей на том сервере. Эмбеддер обязан быть ТОТ ЖЕ, которым
# индексировали: иначе поиск начнёт возвращать шум, не падая с ошибкой
GEN_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# Какое API дёргать у Ollama: openai (по умолчанию, пути /v1/...) или native
# (родные /api/embed и /api/chat). Некоторые шлюзы пробрасывают только одно
# из двух — если в логах 404 на /v1/embeddings, ставьте native
OLLAMA_API=openai

# --- ГДЕ ХРАНИТЬ ДАННЫЕ ---
# Диск с запасом: база растёт вместе с документами (~1 ГБ на тысячу).
# Каталоги создадутся сами при первом запуске
QDRANT_DIR=D:\local-ai\qdrant
DOCS_DIR=D:\local-ai\docs
CODE_DIR=D:\local-ai\code

# --- CONFLUENCE ---
# Выгрузка страниц в markdown. Запускается в контейнере, Python на сервере
# не нужен:
#     docker compose exec kb python confluence/sync.py --check
#     docker compose exec kb python confluence/sync.py
#     docker compose exec kb python -m kb.doc_index /docs/confluence --source confluence
#
# Адрес вики. Если она в подкаталоге, укажите целиком: https://host/confluence
CONFLUENCE_URL=

# Personal Access Token: в Confluence профиль -> Personal Access Tokens.
# Это НЕ пароль. Уходит заголовком Authorization: Bearer
CONFLUENCE_TOKEN=

# Что выгружать. Идентификаторы КОРНЕВЫХ страниц через запятую: забирается
# сама страница и всё поддерево под ней, на любой глубине.
# Идентификатор виден в адресе: .../pages/viewpage.action?pageId=123456
CONFLUENCE_PAGES=

# Куда складывать выгруженные страницы. Должно быть ВНУТРИ DOCS_DIR, иначе
# контейнер их не увидит при индексации
CONFLUENCE_OUT=D:\local-ai\docs\confluence


# --- JIRA ---
# Задачи команды: заголовки, описания и комментарии. Запускается там же,
# в контейнере:
#     docker compose exec kb python jira/sync.py --check
#     docker compose exec kb python jira/sync.py
#     docker compose exec kb python -m kb.jira_index /docs/jira
#
# Только Jira Server/Data Center. У Cloud другая схема входа и путь
# /rest/api/3 — скрипт её не умеет.
# Если Jira в подкаталоге, укажите целиком: https://host/jira
JIRA_URL=

# Personal Access Token: профиль -> Personal Access Tokens. Это НЕ пароль.
# В сборках старше Jira 8.14 токенов нет — тогда JIRA_USER и JIRA_PASSWORD
JIRA_TOKEN=
JIRA_USER=
JIRA_PASSWORD=

# Ключи проектов через запятую. Главная граница: чего здесь нет, то не
# выгружается и в базу не попадает. Ключ виден в номере задачи: DEVSEC-412
JIRA_PROJECTS=

# Только задачи своей команды. Логины через запятую (НЕ отображаемые имена):
JIRA_TEAM=
# либо группа Jira — состав тогда правится в Jira, а не здесь:
JIRA_TEAM_GROUP=
# Обе фильтруют по исполнителю, поэтому задачи без исполнителя не приедут

# Глубина истории: 30d, 6M или дата 2026-08-01. Старые задачи в поиске
# в основном шумят, а в индексации стоят дороже всего.
# ОСТОРОЖНО: строчная m в JQL — это МИНУТЫ, месяцы — заглавная M
JIRA_SINCE=30d

# Своё условие JQL, складывается с остальными через AND
JIRA_JQL=

# Комментарии: 1 — тянуть (в обсуждении обычно и лежит решение), 0 — нет
JIRA_COMMENTS=1

# Куда складывать. Должно быть ВНУТРИ DOCS_DIR
JIRA_OUT=D:\local-ai\docs\jira


# --- КОД ---
# Два способа.
#
# 1. Код уже есть на диске — просто укажите папку с ним в CODE_DIR выше,
#    а CODE_REPOS оставьте пустым. Внутри должны лежать каталоги проектов:
#       D:\projects\service-a\
#       D:\projects\service-b\
#    Тогда CODE_DIR=D:\projects
#
# 2. Клонировать самим — перечислите репозитории через запятую, с токеном
#    в URL: https://oauth2:ТОКЕН@git.company.local/team/service.git
CODE_REPOS=

# --- ПОРТЫ ---
# Открыты всем, кто дотянется по сети: аутентификации нет.
# Ограничьте брандмауэром своей подсетью
QDRANT_PORT=6333
KB_PORT=8010
CODE_GRAPH_PORT=8011

# --- ПОИСК ---
# Порог отсечки нерелевантного. Подобран на нашем корпусе, на других данных
# проверить эталонными вопросами (kb/eval.py), а не на глаз
KB_MIN_SCORE=0.48
# Расширение запроса: модель переформулирует вопрос в терминах документации.
# Дало прирост с 87% до 100% на нашем наборе
KB_EXPAND=1
KB_RERANK=0

# --- ЗЕРКАЛА ДЛЯ СБОРКИ ОБРАЗОВ ---
# Нужны только там, где нет прямого выхода в интернет. Значения по умолчанию —
# публичные адреса, на машине с доступом этот раздел можно не трогать.
# Действуют ТОЛЬКО во время сборки образов, на работу стека не влияют.
# Подробные пояснения — в .env.example

# Индекс PyPI, хвост /simple обязателен:
#   PIP_INDEX_URL=https://nexus.company.local/repository/pypi-proxy/simple
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

# git в образе code-graph. Нужен, только если заполнена CODE_REPOS.
# При no апт не задействован вовсе, и зеркала Debian не нужны
INSTALL_GIT=no

# Действует только при INSTALL_GIT=yes. Адреса задаются целиком; security —
# отдельный репозиторий, без него apt полезет наружу и упадёт
APT_URI=
APT_SECURITY_URI=
APT_SUITES=trixie trixie-updates
# yes — не проверять подпись репозитория (ослабление, см. .env.example)
APT_TRUSTED=no
